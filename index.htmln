                },
                {
                    id: 'rev-6',
                    author: 'Juan David Mejía',
                    productName: 'Gafas Nómada Ónix Polarizadas',
                    rating: 5,
                    text: 'Reducen muy bien el reflejo del sol y tienen un ajuste firme sin incomodar.',
                    photo: '',
                    date: 'Hace 6 días'
                },
                {
                    id: 'rev-7',
                    author: 'Salomé Cardona',
                    productName: 'Camiseta Nómada Oro Clásico',
                    rating: 5,
                    text: 'Me encantó girar la tragamonedas y abrir el sobre sorpresa al finalizar mi compra.',
                    photo: '',
                    date: 'Hace 1 semana'
                },
                {
                    id: 'rev-8',
                    author: 'Tomás Giraldo',
                    productName: 'Buzo Nómada Noche Urbana',
                    rating: 5,
                    text: 'Pedí a domicilio y llegó impecable. Muy buena presentación y atención.',
                    photo: '',
                    date: 'Hace 1 semana'
                },
                {
                    id: 'rev-9',
                    author: 'Daniela Bedoya',
                    productName: 'Gafas Nómada Solaris Gold',
                    rating: 5,
                    text: 'Un diseño que resalta con facilidad y eleva cualquier outfit diario.',
                    photo: '',
                    date: 'Hace 2 semanas'
                }
            ];

            let appState = {
                products: DEFAULT_CATALOG.slice(),
                prizes: DEFAULT_PRIZES.slice(),
                cart: [],
                session: {
                    role: 'GUEST', // 'GUEST' | 'CLIENT' | 'ADMIN'
                    fullName: '',
                    phone: ''
                },
                pageRatings: [5, 5, 5, 5, 5, 5, 5, 5, 5],
                productRatings: {
                    'prod-rimless-degrade': [5, 5, 5, 5, 5],
                    'prod-gafas-solaris': [5, 5, 5, 5, 5],
                    'prod-gafas-onix': [5, 5, 5, 4, 5],
                    'prod-ropa-camiseta-oro': [5, 5, 5, 5, 5],
                    'prod-ropa-buzo-noche': [5, 5, 5, 5, 5]
                },
                comments: INITIAL_REVIEWS.slice(),
                improvements: [],
                filter: 'ALL'
            };

            let activeFlowItems = [];
            let slotSpun = false;
            let envelopeOpened = false;
            let currentPrizeText = '';
            let currentPrizeCode = '';
            let uploadedCommentPhoto = '';
            let uploadedProductPhoto = '';
            let idbHandle = null;

            function reportError(errMsg) {
                const banner = document.getElementById('globalErrorBanner');
                const textEl = document.getElementById('globalErrorMessage');
                if (banner && textEl) {
                    textEl.textContent = errMsg || 'Ocurrió un inconveniente menor en la interfaz.';
                    banner.classList.remove('hidden');
                }
            }

            function showToast(msg) {
                const el = document.getElementById('toastNotification');
                if (!el) return;
                el.textContent = msg;
                el.classList.remove('hidden');
                clearTimeout(showToast._timer);
                showToast._timer = setTimeout(() => {
                    el.classList.add('hidden');
                }, 3200);
            }

            function formatCOP(amount) {
                const num = Number(amount) || 0;
                return '$' + num.toLocaleString('es-CO');
            }

            function escapeHTML(str) {
                return String(str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function hydrateState(incoming) {
                if (!incoming || typeof incoming !== 'object') return;
                appState = {
                    ...appState,
                    ...incoming,
                    session: {
                        role: 'GUEST',
                        fullName: '',
                        phone: '',
                        ...(incoming.session || {})
                    }
                };
                if (!Array.isArray(appState.products) || !appState.products.length) {
                    appState.products = DEFAULT_CATALOG.slice();
                }
                if (!Array.isArray(appState.prizes) || !appState.prizes.length) {
                    appState.prizes = DEFAULT_PRIZES.slice();
                }
                if (!Array.isArray(appState.cart)) appState.cart = [];
                if (!Array.isArray(appState.pageRatings)) appState.pageRatings = [5, 5, 5, 5, 5, 5, 5, 5, 5];
                if (!appState.productRatings || typeof appState.productRatings !== 'object') appState.productRatings = {};
                if (!Array.isArray(appState.comments) || !appState.comments.length) {
                    appState.comments = INITIAL_REVIEWS.slice();
                }
                if (!Array.isArray(appState.improvements)) appState.improvements = [];
            }

            function openIDB() {
                return new Promise((resolve) => {
                    if (!('indexedDB' in window)) return resolve(null);
                    try {
                        const req = indexedDB.open(IDB_NAME, 1);
                        req.onupgradeneeded = function (ev) {
                            const db = ev.target.result;
                            if (!db.objectStoreNames.contains(IDB_STORE)) {
                                db.createObjectStore(IDB_STORE, { keyPath: 'id' });
                            }
                        };
                        req.onsuccess = function (ev) {
                            idbHandle = ev.target.result;
                            resolve(idbHandle);
                        };
                        req.onerror = function () {
                            resolve(null);
                        };
                    } catch (_) {
                        resolve(null);
                    }
                });
            }

            async function loadPersistedData() {
                try {
                    const savedLocal = localStorage.getItem(LOCAL_STORAGE_KEY);
                    if (savedLocal) hydrateState(JSON.parse(savedLocal));
                } catch (err) {
                    console.warn('localStorage no disponible:', err);
                }

                try {
                    const db = await openIDB();
                    if (db) {
                        await new Promise((resolve) => {
                            const tx = db.transaction(IDB_STORE, 'readonly');
                            const req = tx.objectStore(IDB_STORE).get('state_v1');
                            req.onsuccess = function () {
                                if (req.result && req.result.payload) {
                                    hydrateState(req.result.payload);
                                }
                                resolve();
                            };
                            req.onerror = function () {
                                resolve();
                            };
                        });
                    }
                } catch (err) {
                    console.warn('IndexedDB no disponible:', err);
                }
            }

            function savePersistedData() {
                try {
                    localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(appState));
                } catch (err) {
                    console.warn('Error guardando en localStorage:', err);
                }

                if (idbHandle) {
                    try {
                        const tx = idbHandle.transaction(IDB_STORE, 'readwrite');
                        tx.objectStore(IDB_STORE).put({ id: 'state_v1', payload: appState });
                    } catch (err) {
                        console.warn('Error guardando en IndexedDB:', err);
                    }
                }
            }

            // Compresión de imágenes desde galería a 800px de ancho máximo
            function compressGalleryImage(file, maxWidth, callback) {
                if (!file) return callback('');
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const img = new Image();
                    img.onload = function () {
                        try {
                            const limit = maxWidth || 800;
                            const scale = img.width > limit ? limit / img.width : 1;
                            const canvas = document.createElement('canvas');
                            canvas.width = Math.max(1, Math.round(img.width * scale));
                            canvas.height = Math.max(1, Math.round(img.height * scale));
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                            callback(canvas.toDataURL('image/jpeg', 0.84));
                        } catch (_) {
                            callback(ev.target.result || '');
                        }
                    };
                    img.onerror = function () {
                        callback('');
                    };
                    img.src = ev.target.result;
                };
                reader.onerror = function () {
                    callback('');
                };
                reader.readAsDataURL(file);
            }

            function renderSessionBar() {
                const label = document.getElementById('topSessionLabel');
                const loginBtn = document.getElementById('btnOpenSessionModal');
                const logoutBtn = document.getElementById('btnLogoutSession');

                if (appState.session.role === 'CLIENT' && appState.session.fullName) {
                    label.textContent = appState.session.fullName;
                    loginBtn.classList.add('hidden');
                    logoutBtn.classList.remove('hidden');
                } else if (appState.session.role === 'ADMIN') {
                    label.textContent = 'Administrador';
                    loginBtn.classList.add('hidden');
                    logoutBtn.classList.remove('hidden');
                } else {
                    label.textContent = 'Cliente Invitado';
                    loginBtn.classList.remove('hidden');
                    logoutBtn.classList.add('hidden');
                }
            }

            function renderPageRating() {
                const el = document.getElementById('pageScoreDisplay');
                if (!el) return;
                const list = appState.pageRatings;
                if (!list.length) {
                    el.textContent = '5.0 ★ (0 votos)';
                    return;
                }
                const avg = (list.reduce((acc, n) => acc + n, 0) / list.length).toFixed(1);
                el.textContent = `${avg} ★ (${list.length} ${list.length === 1 ? 'voto' : 'votos'})`;
            }

            function getProductRating(productId) {
                const list = appState.productRatings[productId] || [];
                if (!list.length) return { avg: '5.0', count: 0 };
                const avg = (list.reduce((acc, n) => acc + n, 0) / list.length).toFixed(1);
                return { avg, count: list.length };
            }

            function renderCatalog() {
                const grid = document.getElementById('productGrid');
                const commentSelect = document.getElementById('commentProductSelect');
                if (!grid) return;

                if (commentSelect) {
                    commentSelect.innerHTML = appState.products
                        .map(p => `<option value="${escapeHTML(p.name)}">${escapeHTML(p.name)}</option>`)
                        .join('');
                }

                const filtered = appState.filter === 'ALL'
                    ? appState.products
                    : appState.products.filter(p => p.category === appState.filter);

                if (!filtered.length) {
                    grid.innerHTML = `<div class="col-span-full text-center py-10 text-sm text-zinc-400">No hay artículos en esta categoríaFlujo unificado: Compra / Carrito -> Juega y Gana -> Formulario Final WhatsApp
            function openUnifiedFlow(items) {
                activeFlowItems = Array.isArray(items) && items.length
                    ? items.map(i => ({ ...i }))
                    : [{ ...appState.products[0], qty: 1 }];

                slotSpun = false;
                envelopeOpened = false;
                currentPrizeText = '';
                currentPrizeCode = '';

                document.getElementById('slotReelA').textContent = '🕶️';
                document.getElementById('slotReelB').textContent = '✨';
                document.getElementById('slotReelC').textContent = '🎁';

                document.querySelectorAll('.surprise-envelope').forEach((btn, idx) => {
                    btn.classList.add('opacity-55', 'cursor-not-allowed');
                    btn.innerHTML = `<span class="text-2xl">✉️</span><span class="text-xs font-extrabold text-amber-300">Sobre ${idx + 1}</span>`;
                });

                document.getElementById('wonPrizeBox').classList.add('hidden');
                document.getElementById('stepGameBox').classList.remove('hidden');
                document.getElementById('claimOrderForm').classList.add('hidden');
                document.getElementById('flowModalTitle').textContent = 'Juega y Gana';
                document.getElementById('flowOverlay').classList.remove('hidden');
            }

            function spinSlotReels() {
                if (slotSpun) {
                    showToast('Ya giraste la tragamonedas; abre uno de los 3 sobres.');
                    return;
                }
                const symbols = ['🕶️', '👕', '✨', '🎁', '🔥'];
                const rA = document.getElementById('slotReelA');
                const rB = document.getElementById('slotReelB');
                const rC = document.getElementById('slotReelC');

                let ticks = 0;
                const interval = setInterval(() => {
                    ticks++;
                    rA.textContent = symbols[Math.floor(Math.random() * symbols.length)];
                    rB.textContent = symbols[Math.floor(Math.random() * symbols.length)];
                    rC.textContent = symbols[Math.floor(Math.random() * symbols.length)];
                    if (ticks >= 10) {
                        clearInterval(interval);
                        rA.textContent = '🕶️';
                        rB.textContent = '🎁';
                        rC.textContent = '✨';
                        slotSpun = true;

                        document.querySelectorAll('.surprise-envelope').forEach(btn => {
                            btn.classList.remove('opacity-55', 'cursor-not-allowed');
                        });
                        showToast('¡Tragamonedas lista! Selecciona 1 de los 3 sobres.');
                    }
                }, 70);
            }

            function pickSurpriseEnvelope(envNum) {
                if (!slotSpun) {
                    showToast('Primero gira la tragamonedas.');
                    return;
                }
                if (envelopeOpened) {
                    showToast('Ya abriste tu sobre sorpresa.');
                    return;
                }
                envelopeOpened = true;
                const pool = appState.prizes.length ? appState.prizes : DEFAULT_PRIZES;
                currentPrizeText = pool[Math.floor(Math.random() * pool.length)];
                currentPrizeCode = 'NOM-' + String(Math.floor(1000 + Math.random() * 9000));

                const btn = document.querySelector(`.surprise-envelope[data-envelope-index="${envNum}"]`);
                if (btn) {
                    btn.innerHTML = `<span class="text-2xl">🎉</span><span class="text-[11px] font-black text-emerald-300">${currentPrizeCode}</span>`;
                }

                document.getElementById('wonPrizeSummary').textContent = `${currentPrizeCode} — ${currentPrizeText}`;
                document.getElementById('wonPrizeBox').classList.remove('hidden');
            }

            function syncDeliveryUI() {
                const selected = (document.querySelector('input[name="claimDeliveryMode"]:checked') || {}).value || 'DOMICILIO';
                const domContainer = document.getElementById('domicilioFieldsContainer');
                const pickBox = document.getElementById('recogerInfoBox');

                if (selected === 'RECOGER') {
                    domContainer.classList.add('hidden');
                    pickBox.classList.remove('hidden');
                } else {
                    domContainer.classList.remove('hidden');
                    pickBox.classList.add('hidden');
                }
            }

            function openClaimFormStep() {
                if (!currentPrizeCode || !currentPrizeText) {
                    showToast('Abre uno de los sobres para obtener tu premio.');
                    return;
                }
                document.getElementById('stepGameBox').classList.add('hidden');
                document.getElementById('claimOrderForm').classList.remove('hidden');
                document.getElementById('flowModalTitle').textContent = 'Finalizar pedido por WhatsApp';

                document.getElementById('claimPrizeField').value = `${currentPrizeCode} — ${currentPrizeText}`;

                if (appState.session.role === 'CLIENT' && appState.session.fullName) {
                    const parts = appState.session.fullName.trim().split(/\s+/);
                    document.getElementById('claimFirstNameField').value = parts[0] || '';
                    document.getElementById('claimLastNameField').value = parts.slice(1).join(' ') || '';
                }
                if (appState.session.phone) {
                    document.getElementById('claimWhatsappField').value = appState.session.phone;
                }

                const totalQty = activeFlowItems.reduce((sum, it) => sum + (it.qty || 1), 0);
                document.getElementById('claimUnitsField').value = String(Math.max(1, totalQty));

                const firstCat = (activeFlowItems[0] && activeFlowItems[0].category) || 'GAFAS';
                const channelToSelect = firstCat === 'ROPA' ? 'ROPA' : 'GAFAS';
                const radioChannel = document.querySelector(`input[name="claimSellerChannel"][value="${channelToSelect}"]`);
                if (radioChannel) radioChannel.checked = true;

                syncDeliveryUI();
            }

            function submitClaimForm(e) {
                e.preventDefault();

                const firstName = document.getElementById('claimFirstNameField').value.trim();
                const lastName = document.getElementById('claimLastNameField').value.trim();
                const whatsapp = document.getElementById('claimWhatsappField').value.trim();
                const units = Math.max(1, parseInt(document.getElementById('claimUnitsField').value, 10) || 1);
                const prize = document.getElementById('claimPrizeField').value.trim();
                const deliveryMode = (document.querySelector('input[name="claimDeliveryMode"]:checked') || {}).value || 'DOMICILIO';
                const sellerChannel = (document.querySelector('input[name="claimSellerChannel"]:checked') || {}).value || 'GAFAS';

                if (!firstName || !lastName || !whatsapp) {
                    showToast('Completa Nombre, Apellido y WhatsApp.');
                    return;
                }

                let deliverySummary = '';
                if (deliveryMode === 'DOMICILIO') {
                    const street = document.getElementById('domStreet').value.trim();
                    const neighborhood = document.getElementById('domNeighborhood').value.trim();
                    const homeUnit = document.getElementById('domHomeUnit').value.trim();
                    const complexType = document.getElementById('domComplexType').value;
                    const notes = document.getElementById('domNotes').value.trim();

                    if (!street || !neighborhood || !homeUnit) {
                        showToast('Completa Carrera/Calle, Barrio y Casa o Apartamento.');
                        return;
                    }

                    deliverySummary = [
                        'Entrega: Solicitar domicilio',
                        `Carrera/Calle: ${street}`,
                        `Barrio: ${neighborhood}`,
                        `Casa o Apartamento: ${homeUnit}`,
                        `Conjunto residencial: ${complexType}`,
                        notes ? `Notas para el domiciliario: ${notes}` : ''
                    ].filter(Boolean).join('\n');
                } else {
                    deliverySummary = 'Entrega: Recoger personalmente (el vendedor enviará la dirección por WhatsApp).';
                }

                const itemsText = activeFlowItems
                    .map(it => `• ${it.name} (${it.category}) x${it.qty || 1} — ${formatCOP((it.price || 0) * (it.qty || 1))}`)
                    .join('\n');

                const message = [
                    '¡Hola NÓMADA CONCEPT! Quiero confirmar mi pedido:',
                    `Nombre: ${firstName}`,
                    `Apellido: ${lastName}`,
                    `WhatsApp: ${whatsapp}`,
                    `Unidades: ${units}`,
                    `Premio: ${prize}`,
                    itemsText ? `Artículos:\n${itemsText}` : '',
                    deliverySummary
                ].filter(Boolean).join('\n');

                const targetPhone = sellerChannel === 'ROPA'
                    ? SELLER_WHATSAPP.ROPA
                    : SELLER_WHATSAPP.GAFAS;

                const waUrl = `https://wa.me/${targetPhone}?text=${encodeURIComponent(message)}`;
                window.open(waUrl, '_blank', 'noopener,noreferrer');
                document.getElementById('flowOverlay').classList.add('hidden');
                showToast('Abriendo WhatsApp con el detalle de tu pedido...');
            }

            // 4 casillas de PIN del administrador con avance automático y retroceso
            function initPinKeypad() {
                const inputs = Array.from(document.querySelectorAll('#adminPinBoxes .pin-digit'));
                inputs.forEach((box, idx) => {
                    box.addEventListener('input', () => {
                        box.value = box.value.replace(/\D/g, '').slice(0, 1);
                        if (box.value && idx < inputs.length - 1) {
                            inputs[idx + 1].focus();
                        }
                    });
                    box.addEventListener('keydown', (e) => {
                        if (e.key === 'Backspace' && !box.value && idx > 0) {
                            inputs[idx - 1].focus();
                        }
                    });
                });
            }

            function getPinCode() {
                return Array.from(document.querySelectorAll('#adminPinBoxes .pin-digit'))
                    .map(box => box.value)
                    .join('');
            }

            function resetPinCode() {
                Array.from(document.querySelectorAll('#adminPinBoxes .pin-digit'))
                    .forEach(box => {
                        box.value = '';
                    });
            }

            function setSessionTab(mode) {
                const tabClient = document.getElementById('modeTabClient');
                const tabAdmin = document.getElementById('modeTabAdmin');
                const formClient = document.getElementById('clientModeForm');
                const formAdmin = document.getElementById('adminModeForm');

                if (mode === 'ADMIN') {
                    tabAdmin.className = 'py-2.5 rounded-xl bg-amber-400 text-zinc-950 font-extrabold text-xs sm:text-sm transition';
                    tabClient.className = 'py-2.5 rounded-xl text-zinc-300 hover:text-white font-bold text-xs sm:text-sm transition';
                    formAdmin.classList.remove('hidden');
                    formClient.classList.add('hidden');
                    const firstBox = document.querySelector('#adminPinBoxes .pin-digit');
                    if (firstBox) setTimeout(() => firstBox.focus(), 40);
                } else {
                    tabClient.className = 'py-2.5 rounded-xl bg-amber-400 text-zinc-950 font-extrabold text-xs sm:text-sm transition';
                    tabAdmin.className = 'py-2.5 rounded-xl text-zinc-300 hover:text-white font-bold text-xs sm:text-sm transition';
                    formClient.classList.remove('hidden');
                    formAdmin.classList.add('hidden');
                }
            }

            function clearAdminProductForm() {
                document.getElementById('adminEditProductId').value = '';
                document.getElementById('adminFormHeading').textContent = 'Agregar nuevo artículo';
                document.getElementById('btnCancelEditProduct').classList.add('hidden');
                document.getElementById('adminProductForm').reset();
                document.getElementById('adminProdPreviewWrap').classList.add('hidden');
                uploadedProductPhoto = '';
            }

            function attachEvents() {
                document.getElementById('btnDismissError').addEventListener('click', () => {
                    document.getElementById('globalErrorBanner').classList.add('hidden');
                });

                document.getElementById('btnBackNav').addEventListener('click', () => {
                    if (window.history.length > 1) {
                        window.history.back();
                    } else {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });

                document.getElementById('btnNavCatalog').addEventListener('click', () => {
                    document.getElementById('catalogSection').scrollIntoView({ behavior: 'smooth' });
                });

                document.getElementById('btnNavGame').addEventListener('click', () => {
                    openUnifiedFlow(appState.cart.length ? appState.cart : [{ ...appState.products[0], qty: 1 }]);
                });

                document.getElementById('btnHeroPlayGame').addEventListener('click', () => {
                    openUnifiedFlow(appState.cart.length ? appState.cart : [{ ...appState.products[0], qty: 1 }]);
                });

                document.getElementById('btnNavReviews').addEventListener('click', () => {
                    document.getElementById('reviewsSection').scrollIntoView({ behavior: 'smooth' });
                });

                // Puntaje general de la página
                document.querySelectorAll('[data-page-score]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const val = parseInt(btn.getAttribute('data-page-score'), 10);
                        if (val >= 1 && val <= 5) {
                            appState.pageRatings.push(val);
                            savePersistedData();
                            renderPageRating();
                            showToast(`¡Gracias! Calificaste la página con ${val} estrellas.`);
                        }
                    });
                });

                // Filtros del catálogo
                document.querySelectorAll('.cat-filter-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        appState.filter = btn.getAttribute('data-cat-filter') || 'ALL';
                        document.querySelectorAll('.cat-filter-btn').forEach(b => {
                            b.className = 'cat-filter-btn px-4 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs font-bold transition';
                        });
                        btn.className = 'cat-filter-btn px-4 py-2 rounded-xl bg-amber-400 text-zinc-950 text-xs font-extrabold transition';
                        renderCatalog();
                    });
                });

                // Interacciones en tarjetas de productos
                document.getElementById('productGrid').addEventListener('click', (e) => {
                    const zoomEl = e.target.closest('[data-open-lightbox]');
                    if (zoomEl) {
                        document.getElementById('lightboxPhoto').src = zoomEl.getAttribute('data-open-lightbox');
                        document.getElementById('lightboxCaption').textContent = zoomEl.getAttribute('data-lightbox-title') || 'Vista ampliada';
                        document.getElementById('lightboxOverlay').classList.remove('hidden');
                        return;
                    }

                    const rateBtn = e.target.closest('[data-rate-item]');
                    if (rateBtn) {
                        const pid = rateBtn.getAttribute('data-rate-item');
                        const score = parseInt(rateBtn.getAttribute('data-rate-val'), 10);
                        if (!appState.productRatings[pid]) appState.productRatings[pid] = [];
                        appState.productRatings[pid].push(score);
                        savePersistedData();
                        renderCatalog();
                        showToast(`Calificaste el artículo con ${score} estrellas.`);
                        return;
                    }

                    const cartBtn = e.target.closest('[data-add-to-cart]');
                    if (cartBtn) {
                        const pid = cartBtn.getAttribute('data-add-to-cart');
                        const prod = appState.products.find(p => p.id === pid);
                        if (!prod) return;
                        const existing = appState.cart.find(c => c.id === pid);
                        if (existing) existing.qty += 1;
                        else appState.cart.push({ ...prod, qty: 1 });
                        savePersistedData();
                        renderCart();
                        showToast(`"${prod.name}" agregado al carrito.`);
                        return;
                    }

                    const buyBtn = e.target.closest('[data-buy-play]');
                    if (buyBtn) {
                        const pid = buyBtn.getAttribute('data-buy-play');
                        const prod = appState.products.find(p => p.id === pid);
                        if (!prod) return;
                        openUnifiedFlow([{ ...prod, qty: 1 }]);
                    }
                });

                document.getElementById('btnCloseLightbox').addEventListener('click', () => {
                    document.getElementById('lightboxOverlay').classList.add('hidden');
                });

                // Sesión dividida Cliente / Administrador
                document.getElementById('btnOpenSessionModal').addEventListener('click', () => {
                    setSessionTab('CLIENT');
                    document.getElementById('sessionOverlay').classList.remove('hidden');
                });

                document.getElementById('btnCloseSessionModal').addEventListener('click', () => {
                    resetPinCode();
                    document.getElementById('sessionOverlay').classList.add('hidden');
                });

                document.getElementById('modeTabClient').addEventListener('click', () => setSessionTab('CLIENT'));
                document.getElementById('modeTabAdmin').addEventListener('click', () => setSessionTab('ADMIN'));

                document.getElementById('clientModeForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const first = document.getElementById('sessionFirstName').value.trim();
                    const last = document.getElementById('sessionLastName').value.trim();
                    const phone = document.getElementById('sessionPhone').value.trim()    // Puntaje general de la página
                document.querySelectorAll('[data-page-score]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const val = parseInt(btn.getAttribute('data-page-score'), 10);
                        if (val >= 1 && val <= 5) {
                            appState.pageRatings.push(val);
                            savePersistedData();
                            renderPageRating();
                            showToast(`¡Gracias! Calificaste la página con ${val} estrellas.`);
                        }
                    });
                });

                // Filtros del catálogo
                document.querySelectorAll('.cat-filter-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        appState.filter = btn.getAttribute('data-cat-filter') || 'ALL';
                        document.querySelectorAll('.cat-filter-btn').forEach(b => {
                            b.className = 'cat-filter-btn px-4 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs font-bold transition';
                        });
                        btn.className = 'cat-filter-btn px-4 py-2 rounded-xl bg-amber-400 text-zinc-950 text-xs font-extrabold transition';
                        renderCatalog();
                    });
                });

                // Interacciones en tarjetas de productos
                document.getElementById('productGrid').addEventListener('click', (e) => {
                    const zoomEl = e.target.closest('[data-open-lightbox]');
                    if (zoomEl) {
                        document.getElementById('lightboxPhoto').src = zoomEl.getAttribute('data-open-lightbox');
                        document.getElementById('lightboxCaption').textContent = zoomEl.getAttribute('data-lightbox-title') || 'Vista ampliada';
                        document.getElementById('lightboxOverlay').classList.remove('hidden');
                        return;
                    }

                    const rateBtn = e.target.closest('[data-rate-item]');
                    if (rateBtn) {
                        const pid = rateBtn.getAttribute('data-rate-item');
                        const score = parseInt(rateBtn.getAttribute('data-rate-val'), 10);
                        if (!appState.productRatings[pid]) appState.productRatings[pid] = [];
                        appState.productRatings[pid].push(score);
                        savePersistedData();
                        renderCatalog();
                        showToast(`Calificaste el artículo con ${score} estrellas.`);
                        return;
                    }

                    const cartBtn = e.target.closest('[data-add-to-cart]');
                    if (cartBtn) {
                        const pid = cartBtn.getAttribute('data-add-to-cart');
                        const prod = appState.products.find(p => p.id === pid);
                        if (!prod) return;
                        const existing = appState.cart.find(c => c.id === pid);
                        if (existing) existing.qty += 1;
                        else appState.cart.push({ ...prod, qty: 1 });
                        savePersistedData();
                        renderCart();
                        showToast(`"${prod.name}" agregado al carrito.`);
                        return;
                    }

                    const buyBtn = e.target.closest('[data-buy-play]');
                    if (buyBtn) {
                        const pid = buyBtn.getAttribute('data-buy-play');
                        const prod = appState.products.find(p => p.id === pid);
                        if (!prod) return;
                        openUnifiedFlow([{ ...prod, qty: 1 }]);
                    }
                });

                document.getElementById('btnCloseLightbox').addEventListener('click', () => {
                    document.getElementById('lightboxOverlay').classList.add('hidden');
                });

                // Sesión dividida Cliente / Administrador
                document.getElementById('btnOpenSessionModal').addEventListener('click', () => {
                    setSessionTab('CLIENT');
                    document.getElementById('sessionOverlay').classList.remove('hidden');
                });

                document.getElementById('btnCloseSessionModal').addEventListener('click', () => {
                    resetPinCode();
                    document.getElementById('sessionOverlay').classList.add('hidden');
                });

                document.getElementById('modeTabClient').addEventListener('click', () => setSessionTab('CLIENT'));
                document.getElementById('modeTabAdmin').addEventListener('click', () => setSessionTab('ADMIN'));

                document.getElementById('clientModeForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const first = document.getElementById('sessionFirstName').value.trim();
                    const last = document.getElementById('sessionLastName').value.trim();
                    const phone = document.getElementById('sessionPhone').value.trim();
                    if (!first || !last) {
                        showToast('Ingresa tu nombre y apellido.');
                        return;
                    }
                    appState.session = {
                        role: 'CLIENT',
                        fullName: `${first} ${last}`,
                        phone
                    };
                    savePersistedData();
                    renderSessionBar();
                    document.getElementById('sessionOverlay').classList.add('hidden');
                    showToast(`Sesión iniciada: ${appState.session.fullName}`);
                });

                document.getElementById('adminModeForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const pin = getPinCode();
                    if (pin === ADMIN_PIN) {
                        resetPinCode();
                        appState.session = {
                            role: 'ADMIN',
                            fullName: 'Administrador',
                            phone: ''
                        };
                        savePersistedData();
                        renderSessionBar();
                        document.getElementById('sessionOverlay').classList.add('hidden');
                        clearAdminProductForm();
                        renderAdminPanel();
                        document.getElementById('adminPanelOverlay').classList.remove('hidden');
                        showToast('Acceso de administrador habilitado.');
                    } else {
                        resetPinCode();
                        const firstBox = document.querySelector('#adminPinBoxes .pin-digit');
                        if (firstBox) firstBox.focus();
                        showToast('PIN de 4 dígitos incorrecto.');
                    }
                });

                document.getElementById('btnLogoutSession').addEventListener('click', () => {
                    appState.session = { role: 'GUEST', fullName: '', phone: '' };
                    savePersistedData();
                    renderSessionBar();
                    document.getElementById('adminPanelOverlay').classList.add('hidden');
                    showToast('Sesión cerrada.');
                });

                // Carrito drawer
                document.getElementById('btnOpenCartDrawer').addEventListener('click', () => {
                    renderCart();
                    document.getElementById('cartOverlay').classList.remove('hidden');
                });

                document.getElementById('btnCloseCartDrawer').addEventListener('click', () => {
                    document.getElementById('cartOverlay').classList.add('hidden');
                });

                document.getElementById('cartListContainer').addEventListener('click', (e) => {
                    const incId = e.target.getAttribute('data-cart-inc');
                    const decId = e.target.getAttribute('data-cart-dec');
                    const remId = e.target.getAttribute('data-cart-remove');

                    if (incId) {
                        const item = appState.cart.find(c => c.id === incId);
                        if (item) item.qty += 1;
                    } else if (decId) {
                        const idx = appState.cart.findIndex(c => c.id === decId);
                        if (idx > -1) {
                            if (appState.cart[idx].qty > 1) appState.cart[idx].qty -= 1;
                            else appState.cart.splice(idx, 1);
                        }
                    } else if (remId) {
                        appState.cart = appState.cart.filter(c => c.id !== remId);
                    }

                    savePersistedData();
                    renderCart();
                });

                document.getElementById('btnCartToGame').addEventListener('click', () => {
                    if (!appState.cart.length) {
                        showToast('Agrega al menos un artículo al carrito.');
                        return;
                    }
                    document.getElementById('cartOverlay').classList.add('hidden');
                    openUnifiedFlow(appState.cart);
                });

                // Flujo Juega y Gana + Formulario Final WhatsApp
                document.getElementById('btnCloseFlowModal').addEventListener('click', () => {
                    document.getElementById('flowOverlay').classList.add('hidden');
                });

                document.getElementById('btnSpinSlotMachine').addEventListener('click', spinSlotReels);

                document.querySelectorAll('.surprise-envelope').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const idx = parseInt(btn.getAttribute('data-envelope-index'), 10);
                        pickSurpriseEnvelope(idx);
                    });
                });

                document.getElementById('btnProceedClaimForm').addEventListener('click', openClaimFormStep);

                document.querySelectorAll('input[name="claimDeliveryMode"]').forEach(radio => {
                    radio.addEventListener('change', syncDeliveryUI);
                });

                document.getElementById('claimOrderForm').addEventListener('submit', submitClaimForm);

                // Reseñas con foto de cómo quedó el artículo + Buzón de mejoras
                document.getElementById('commentPhotoInput').addEventListener('change', (e) => {
                    const file = e.target.files && e.target.files[0];
                    compressGalleryImage(file, 800, (compressed) => {
                        uploadedCommentPhoto = compressed;
                        const box = document.getElementById('commentPhotoPreviewBox');
                        const img = document.getElementById('commentPhotoPreviewImg');
                        if (compressed) {
                            img.src = compressed;
                            box.classList.remove('hidden');
                        } else {
                            box.classList.add('hidden');
                        }
                    });
                });

                document.getElementById('commentForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const typedAuthor = document.getElementById('commentAuthorInput').value.trim();
                    const author = typedAuthor || (appState.session.fullName ? appState.session.fullName : 'Cliente Nómada');
                    const productName = document.getElementById('commentProductSelect').value;
                    const rating = parseInt(document.getElementById('commentRatingSelect').value, 10) || 5;
                    const text = document.getElementById('commentTextInput').value.trim();

                    if (!text) {
                        showToast('Escribe tu comentario antes de publicar.');
                        return;
                    }

                    appState.comments.unshift({
                        id: 'rev-' + Date.now(),
                        author,
                        productName,
                        rating,
                        text,
                        photo: uploadedCommentPhoto,
                        date: 'Justo ahora'
                    });

                    const matchingProd = appState.products.find(p => p.name === productName);
                    if (matchingProd) {
                        if (!appState.productRatings[matchingProd.id]) appState.productRatings[matchingProd.id] = [];
                        appState.productRatings[matchingProd.id].push(rating);
                    }

                    savePersistedData();
                    renderCatalog();
                    renderReviews();
                    renderAdminPanel();

                    document.getElementById('commentTextInput').value = '';
                    document.getElementById('commentPhotoInput').value = '';
                    document.getElementById('commentPhotoPreviewBox').classList.add('hidden');
                    uploadedCommentPhoto = '';
                    showToast('¡Reseña publicada!');
                });

                document.getElementById('commentsFeed').addEventListener('click', (e) => {
                    const imgEl = e.target.closest('[data-open-lightbox]');
                    if (imgEl) {
                        document.getElementById('lightboxPhoto').src = imgEl.getAttribute('data-open-lightbox');
                        document.getElementById('lightboxCaption').textContent = imgEl.getAttribute('data-lightbox-title') || 'Foto de cliente';
                        document.getElementById('lightboxOverlay').classList.remove('hidden');
                    }
                });

                document.getElementById('mailboxForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const text = document.getElementById('mailboxTextInput').value.trim();
                    if (!text) {
                        showToast('Escribe una sugerencia para el buzón de mejoras.');
                        return;
                    }
                    appState.improvements.unshift({
                        author: appState.session.fullName || 'Cliente',
                        text
                    });
                    savePersistedData();
                    renderAdminPanel();
                    document.getElementById('mailboxTextInput').value = '';
                    showToast('Sugerencia enviada al buzón de mejoras.');
                });

                // Panel Administrador (PIN 1980)
                document.getElementById('btnOpenAdminPanel').addEventListener('click', () => {
                    if (appState.session.role === 'ADMIN') {
                        clearAdminProductForm();
                        renderAdminPanel();
                        document.getElementById('adminPanelOverlay').classList.remove('hidden');
                    } else {
                        setSessionTab('ADMIN');
                        document.getElementById('sessionOverlay').classList.remove('hidden');
                    }
                });

                document.getElementById('btnCloseAdminPanel').addEventListener('click', () => {
                    document.getElementById('adminPanelOverlay').classList.add('hidden');
                });

                document.getElementById('adminProdPhotoInput').addEventListener('change', (e) => {
                    const file = e.target.files && e.target.files[0];
                    compressGalleryImage(file, 800, (compressed) => {
                        uploadedProductPhoto = compressed;
                        const wrap = document.getElementById('adminProdPreviewWrap');
                        const img = document.getElementById('adminProdPreviewImg');
                        if (compressed) {
                            img.src = compressed;
                            wrap.classList.remove('hidden');
                        } else {
                            wrap.classList.add('hidden');
                        }
                    });
                });

                document.getElementById('btnCancelEditProduct').addEventListener('click', clearAdminProductForm);

                document.getElementById('adminProductForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    const editId = document.getElementById('adminEditProductId').value.trim();
                    const name = document.getElementById('adminProdName').value.trim();
                    const category = document.getElementById('adminProdCategory').value;
                    const price = parseInt(document.getElementById('adminProdPrice').value, 10) || 0;
                    const description = document.getElementById('adminProdDesc').value.trim();

                    if (!name || !price || !description) {
                        showToast('Completa nombre, precio y descripción.');
                        return;
                    }

                    const fallbackImg = `https://placehold.co/640x480/14141b/fbbf24?text=${encodeURIComponent(name)}`;

                    if (editId) {
                        const idx = appState.products.findIndex(p => p.id === editId);
                        if (idx > -1) {
                            appState.products[idx] = {
                                ...appState.products[idx],
                                name,
                                category,
                                price,
                                description,
                                image: uploadedProductPhoto || appState.products[idx].image || fallbackImg
                            };
                            showToast('Artículo actualizado.');
                        }
                    } else {
                        appState.products.unshift({
                            id: 'prod-' + Date.now(),
                            name,
                            category,
                            price,
                            description,
                            image: uploadedProductPhoto || fallbackImg
                        });
                        showToast('Artículo agregado al catálogo.');
                    }

                    savePersistedData();
                    renderCatalog();
                    renderAdminPanel();
                    clearAdminProductForm();
                });

                document.getElementById('adminProductsList').addEventListener('click', (e) => {
                    const editId = e.target.getAttribute('data-edit-product');
                    const delId = e.target.getAttribute('data-delete-product');

                    if (editId) {
                        const prod = appState.products.find(p => p.id === editId);
