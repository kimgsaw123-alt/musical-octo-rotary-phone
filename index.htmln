                },
                {
                    id: 'rev-2',
                    author: 'Mateo Castaño',
                    productName: 'Gafas Nómada Solaris Gold',
                    rating: 5,
                    text: 'Súper cómodas y livianas para todo el día. La coordinación por WhatsApp fue rápida y clara.',
                    photo: '',
                    date: 'Hace 2 días'
                },
                {
                    id: 'rev-3',
                    author: 'Isabella Arango',
                    productName: 'Camiseta Nómada Oro Clásico',
                    rating: 5,
                    text: 'La tela es de excelente calidad, no pierde la horma y el detalle dorado luce muy elegante.',
                    photo: '',
                    date: 'Hace 3 días'
                },
                {
                    id: 'rev-4',
                    author: 'Sebastián Tobón',
                    productName: 'Buzo Nómada Noche Urbana',
