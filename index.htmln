                    author: 'Valentina Restrepo',
                    productName: 'Gafas Nómada Rimless Degradé & Estuche',
                    rating: 5,
                    text: 'El estilo sin montura con el degradado y el estuche se ven increíbles. ¡Me gané envío gratis en los sobres!',
                    photo: '',
