            // PIN de 4 dígitos para acceder al panel de administración
            const ADMIN_PIN = '1980';

            const LOCAL_STORAGE_KEY = 'nomada_concept_single_v1';
            const IDB_NAME = 'NomadaConceptSingleDB';
            const IDB_STORE = 'snapshots';

            const DEFAULT_CATALOG = [
