```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NÓMADA CONCEPT — Juega y Gana</title>
    <!-- Tailwind CSS para diseño adaptable y utilidades modernas -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tipografía Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* Variables de diseño oscuro y dorado para NÓMADA CONCEPT */
        :root {
            --bg-obsidian: #070709;
            --gold-primary: #f59e0b;
            --gold-bright: #fcd34d;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-obsidian);
            background-image:
                radial-gradient(circle at 12% 10%, rgba(245, 158, 11, 0.24) 0%, transparent 42%),
                radial-gradient(circle at 88% 16%, rgba(251, 191, 36, 0.15) 0%, transparent 46%),
                radial-gradient(circle at 50% 85%, rgba(217, 119, 6, 0.14) 0%, transparent 54%),
                linear-gradient(165deg, #070709 0%, #0e0d12 48%, #070709 100%);
            background-attachment: fixed;
            color: #f9fafb;
            overflow-x: hidden;
            margin: 0;
            position: relative;
        }

        /* Textura sutil de cuadrícula dorada */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            opacity: 0.28;
            background-image:
                linear-gradient(to right, rgba(251, 191, 36, 0.06) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(251, 191, 36, 0.06) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: radial-gradient(ellipse at 50% 25%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 0.25) 85%);
        }

        header, main, footer {
            position: relative;
            z-index: 1;
        }

        .luxury-card {
            background: linear-gradient(155deg, rgba(26, 24, 32, 0.94) 0%, rgba(11, 11, 16, 0.98) 100%);
            border: 1px solid rgba(251, 191, 36, 0.18);
            box-shadow: inset 0 1px 0 rgba(254, 243, 199, 0.08), 0 18px 40px -22px rgba(0, 0, 0, 0.88);
        }

        .gold-shadow {
            box-shadow: 0 14px 34px -12px rgba(245, 158, 11, 0.45);
        }

        @keyframes slotPulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4);
            }
            50% {
                transform: scale(1.02);
                box-shadow: 0 0 22px 2px rgba(245, 158, 11, 0.24);
            }
        }

        .slot-ready {
            animation: slotPulse 2.2s infinite ease-in-out;
        }

        /* Ocultar flechas nativas en entradas de PIN */
        .pin-digit::-webkit-outer-spin-button,
        .pin-digit::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .pin-digit[type=number] {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-amber-400 selection:text-zinc-950">
    <!-- Barra superior con marca, navegación rápida, sesión de cliente y acceso administrador -->
    <header class="sticky top-0 z-40 backdrop-blur-xl bg-zinc-950/90 border-b border-amber-400/15">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2.5">
            <div class="flex items-center gap-2 sm:gap-3">
                <button id="btnBackNav" type="button" class="px-3 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs sm:text-sm font-semibold text-zinc-100 transition flex items-center gap-1.5" aria-label="Atrás">
                    <span>←</span>
                    <span>Atrás</span>
                </button>
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-300 via-amber-500 to-amber-700 text-zinc-950 font-black flex items-center justify-center text-lg shadow-lg">
                        N
                    </div>
                    <div>
                        <div class="text-sm sm:text-base font-black tracking-tight leading-none">
                            NÓMADA <span class="text-amber-400">CONCEPT</span>
                        </div>
                        <div id="topSessionLabel" class="text-xs sm:text-sm text-amber-300 font-bold mt-0.5">
                            Cliente Invitado
                        </div>
                    </div>
                </div>
            </div>

            <nav class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                <button id="btnNavCatalog" type="button" class="px-3 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs sm:text-sm font-semibold transition">
                    Catálogo
                </button>
                <button id="btnNavGame" type="button" class="px-3 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs sm:text-sm font-semibold transition">
                    Juega y Gana
                </button>
                <button id="btnNavReviews" type="button" class="px-3 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs sm:text-sm font-semibold transition">
                    Reseñas
                </button>
                <button id="btnOpenCartDrawer" type="button" class="px-3 py-2 rounded-xl bg-amber-400/15 hover:bg-amber-400/25 border border-amber-400/40 text-amber-300 text-xs sm:text-sm font-bold transition flex items-center gap-1.5">
                    <span>Carrito</span>
                    <span id="headerCartBadge" class="px-1.5 py-0.5 rounded-full bg-amber-400 text-zinc-950 text-xs font-black">0</span>
                </button>
                <button id="btnOpenSessionModal" type="button" class="px-3 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 border border-white/15 text-xs sm:text-sm font-semibold transition">
                    Iniciar sesión
                </button>
                <button id="btnLogoutSession" type="button" class="hidden px-3 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 border border-rose-400/35 text-rose-300 text-xs sm:text-sm font-semibold transition">
                    Cerrar sesión
                </button>
                <button id="btnOpenAdminPanel" type="button" class="px-3 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-zinc-950 text-xs sm:text-sm font-extrabold transition">
                    Admin
                </button>
            </nav>
        </div>
    </header>

    <!-- Notificación flotante no intrusiva -->
    <div id="toastNotification" class="fixed bottom-5 right-5 z-50 hidden max-w-sm rounded-2xl bg-zinc-900 border border-amber-400/50 text-amber-100 px-4 py-3 shadow-2xl text-xs sm:text-sm font-semibold">
    </div>

    <!-- Banner de error límite de aplicación -->
    <div id="globalErrorBanner" class="hidden max-w-7xl w-full mx-auto px-3 sm:px-6 pt-4">
        <div class="rounded-2xl bg-rose-950/80 border border-rose-400/40 px-4 py-3 text-xs sm:text-sm text-rose-100 flex items-center justify-between gap-3">
            <span id="globalErrorMessage">Se detectó una incidencia menor; la página sigue operativa.</span>
            <button id="btnDismissError" type="button" class="px-2.5 py-1 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 font-bold text-xs">
                Cerrar
            </button>
        </div>
    </div>

    <!-- Contenido principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-6 sm:py-8 space-y-12">
        <!-- Portada principal y calificación general -->
        <section class="luxury-card rounded-3xl p-5 sm:p-8 md:p-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <div class="lg:col-span-7 space-y-4">
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/15 border border-amber-400/35 text-amber-300 text-[11px] sm:text-xs font-extrabold uppercase tracking-wider">
                        NÓMADA CONCEPT • Gafas y Ropa • Juega y Gana
                    </span>
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight">
                        Presencia en cada paso y <span class="text-amber-400">premios al comprar</span>.
                    </h1>
                    <p class="text-sm sm:text-base text-zinc-200 leading-relaxed max-w-2xl">
                        Tu estilo habla antes de que digas una palabra. Explora gafas al aire con degradados de exhibición y prendas NÓMADA CONCEPT creadas para acompañarte en tus planes diarios, viajes y salidas especiales. Elige tu modelo favorito o arma tu carrito y, al pasar a <strong class="text-amber-300">Juega y Gana</strong>, gira la tragamonedas y abre uno de los 3 sobres sorpresa para obtener tu código <strong class="text-amber-300">NOM-XXXX</strong>.
                    </p>
                    <div class="flex flex-wrap gap-3 pt-1">
                        <a href="#catalogSection" class="px-5 py-3 rounded-2xl bg-amber-400 hover:bg-amber-300 text-zinc-950 font-extrabold text-xs sm:text-sm transition gold-shadow">
                            Ver catálogo
                        </a>
                        <button id="btnHeroPlayGame" type="button" class="px-5 py-3 rounded-2xl bg-zinc-800 hover:bg-zinc-700 border border-white/15 text-white font-bold text-xs sm:text-sm transition">
                            Ir a Juega y Gana
                        </button>
                    </div>
                </div>

                <!-- Puntaje general de la página y líneas de WhatsApp -->
                <div class="lg:col-span-5 bg-zinc-950/85 border border-white/10 rounded-2xl p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-zinc-400">Puntaje general de la página</span>
                        <span id="pageScoreDisplay" class="text-base font-black text-amber-400">5.0 ★ (9 votos)</span>
                    </div>
                    <p class="text-xs text-zinc-400">Califica la experiencia de NÓMADA CONCEPT de 1 a 5 estrellas:</p>
                    <div class="flex items-center gap-2">
                        <button type="button" data-page-score="1" class="w-10 h-10 rounded-xl bg-zinc-900 hover:bg-amber-400/20 border border-white/10 text-amber-400 font-black text-lg transition">★</button>
                        <button type="button" data-page-score="2" class="w-10 h-10 rounded-xl bg-zinc-900 hover:bg-amber-400/20 border border-white/10 text-amber-400 font-black text-lg transition">★</button>
                        <button type="button" data-page-score="3" class="w-10 h-10 rounded-xl bg-zinc-900 hover:bg-amber-400/20 border border-white/10 text-amber-400 font-black text-lg transition">★</button>
                        <button type="button" data-page-score="4" class="w-10 h-10 rounded-xl bg-zinc-900 hover:bg-amber-400/20 border border-white/10 text-amber-400 font-black text-lg transition">★</button>
                        <button type="button" data-page-score="5" class="w-10 h-10 rounded-xl bg-zinc-900 hover:bg-amber-400/20 border border-white/10 text-amber-400 font-black text-lg transition">★</button>
                    </div>
                    <div class="pt-3 border-t border-white/10 grid grid-cols-2 gap-3 text-center">
                        <div class="rounded-xl bg-zinc-900 p-3 border border-amber-400/15">
                            <div class="text-[11px] text-zinc-400">Gafas Nómada</div>
                            <div class="text-xs sm:text-sm font-extrabold text-amber-300 mt-0.5">310 604 7749</div>
                        </div>
                        <div class="rounded-xl bg-zinc-900 p-3 border border-amber-400/15">
                            <div class="text-[11px] text-zinc-400">Ropas Nómada</div>
                            <div class="text-xs sm:text-sm font-extrabold text-amber-300 mt-0.5">312 414 8578</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Catálogo ilimitado de Gafas Nómada y Ropas Nómada -->
        <section id="catalogSection" class="space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-black tracking-tight">Catálogo NÓMADA CONCEPT</h2>
                    <p class="text-xs sm:text-sm text-zinc-400">Toca cualquier foto para ampliarla, califica cada artículo o pasa a Comprar / Juega y Gana.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" data-cat-filter="ALL" class="cat-filter-btn px-4 py-2 rounded-xl bg-amber-400 text-zinc-950 text-xs font-extrabold transition">
                        Todos
                    </button>
                    <button type="button" data-cat-filter="GAFAS" class="cat-filter-btn px-4 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs font-bold transition">
                        Gafas Nómada
                    </button>
                    <button type="button" data-cat-filter="ROPA" class="cat-filter-btn px-4 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 text-xs font-bold transition">
                        Ropas Nómada
                    </button>
                </div>
            </div>

            <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Productos renderizados dinámicamente -->
            </div>
        </section>

        <!-- Comunidad, Reseñas con foto de cómo quedó el artículo y Buzón de mejoras -->
        <section id="reviewsSection" class="luxury-card rounded-3xl p-5 sm:p-7 space-y-6">
            <div class="border-b border-white/10 pb-4">
                <h2 class="text-xl sm:text-2xl font-black">Reseñas de Clientes y Buzón de Mejoras</h2>
                <p class="text-xs sm:text-sm text-zinc-400">Lee experiencias reales, publica tu calificación y foto de cómo te quedó el artículo, o envía sugerencias de mejora.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Formulario de reseña + foto de cómo quedó el artículo -->
                <form id="commentForm" class="lg:col-span-6 bg-zinc-950/85 border border-white/10 rounded-2xl p-4 sm:p-5 space-y-3.5">
                    <h3 class="text-base font-extrabold text-amber-300">Publicar reseña y foto de cómo quedó el artículo</h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-zinc-400 mb-1">Nombre y Apellido</label>
                            <input id="commentAuthorInput" type="text" placeholder="Ej. Mariana Vélez" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/10 text-sm focus:outline-none focus:border-amber-400">
                        </div>
                        <div>
                            <label class="block text-xs text-zinc-400 mb-1">Artículo</label>
                            <select id="commentProductSelect" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/10 text-sm focus:outline-none focus:border-amber-400">
                                <!-- Opciones cargadas desde el catálogo -->
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Calificación del artículo</label>
                        <select id="commentRatingSelect" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/10 text-sm focus:outline-none focus:border-amber-400">
                            <option value="5" selected>5 estrellas — Excelente</option>
                            <option value="4">4 estrellas — Muy bueno</option>
                            <option value="3">3 estrellas — Bueno</option>
                            <option value="2">2 estrellas — Regular</option>
                            <option value="1">1 estrella — Por mejorar</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Comentario</label>
                        <textarea id="commentTextInput" rows="2" placeholder="Cuéntanos cómo te quedó el artículo y qué te pareció..." class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/10 text-sm focus:outline-none focus:border-amber-400"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Foto de cómo quedó el artículo (desde galería)</label>
                        <input id="commentPhotoInput" type="file" accept="image/*" class="w-full text-xs text-zinc-300 file:mr-3 file:py-2 file:px-3.5 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-amber-400 file:text-zinc-950 hover:file:bg-amber-300 cursor-pointer">
                        <div id="commentPhotoPreviewBox" class="mt-2.5 hidden">
                            <img id="commentPhotoPreviewImg" src="" alt="Vista previa de cómo quedó el artículo" class="w-24 h-24 object-cover rounded-xl border border-amber-400/40">
                        </div>
                    </div>

                    <button type="submit" class="w-full py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-zinc-950 font-extrabold text-sm transition">
                        Publicar reseña
                    </button>
                </form>

                <!-- Buzón de mejoras -->
                <form id="mailboxForm" class="lg:col-span-6 bg-zinc-950/85 border border-white/10 rounded-2xl p-4 sm:p-5 space-y-3.5 flex flex-col justify-between">
                    <div class="space-y-3">
                        <h3 class="text-base font-extrabold text-amber-300">Buzón de mejoras</h3>
                        <p class="text-xs text-zinc-400">Envía ideas o sugerencias para hacer aún mejor la tienda y la experiencia Juega y Gana.</p>
                        <div>
                            <label class="block text-xs text-zinc-400 mb-1">Tu sugerencia</label>
                            <textarea id="mailboxTextInput" rows="4" placeholder="Escribe aquí qué te gustaría ver o mejorar..." class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/10 text-sm focus:outline-none focus:border-amber-400"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="w-full py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 border border-white/15 text-white font-bold text-sm transition">
                        Enviar al buzón de mejoras
                    </button>
                </form>
            </div>

            <!-- Modal unificado: Juega y Gana (Tragamonedas + 3 Sobres NOM-XXXX) -> Formulario Final WhatsApp -->
    <div id="flowOverlay" class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-5">
        <div class="max-w-2xl w-full bg-zinc-900 border border-amber-400/30 rounded-3xl p-5 sm:p-7 space-y-6 shadow-2xl max-h-[92vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <div>
                    <span class="text-[11px] font-extrabold uppercase tracking-wider text-amber-400">NÓMADA CONCEPT</span>
                    <h3 id="flowModalTitle" class="text-lg sm:text-xl font-black">Juega y Gana</h3>
                </div>
                <button id="btnCloseFlowModal" type="button" class="px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-bold">
                    Cerrar ✕
                </button>
            </div>

            <!-- Paso 1: Tragamonedas de 3 carretes + 3 Sobres Sorpresa NOM-XXXX -->
            <div id="stepGameBox" class="space-y-5">
                <div class="bg-zinc-950 border border-white/10 rounded-2xl p-4 sm:p-5 space-y-4">
                    <p class="text-xs text-zinc-400 text-center">1. Gira la tragamonedas para habilitar los 3 sobres sorpresa</p>
                    <div class="grid grid-cols-3 gap-2.5 sm:gap-4 text-center">
                        <div id="slotReelA" class="py-5 rounded-2xl bg-zinc-900 border border-amber-400/30 text-2xl sm:text-3xl font-black text-amber-300">🕶️</div>
                        <div id="slotReelB" class="py-5 rounded-2xl bg-zinc-900 border border-amber-400/30 text-2xl sm:text-3xl font-black text-amber-300">✨</div>
                        <div id="slotReelC" class="py-5 rounded-2xl bg-zinc-900 border border-amber-400/30 text-2xl sm:text-3xl font-black text-amber-300">🎁</div>
                    </div>
                    <button id="btnSpinSlotMachine" type="button" class="w-full py-3 rounded-2xl bg-amber-400 hover:bg-amber-300 text-zinc-950 font-extrabold text-sm transition slot-ready">
                        Girar Tragamonedas
                    </button>
                </div>

                <div class="space-y-2.5">
                    <p class="text-xs text-zinc-400 text-center">2. Elige 1 de los 3 sobres para revelar tu código NOM-XXXX y premio</p>
                    <div class="grid grid-cols-3 gap-3">
                        <button type="button" data-envelope-index="1" class="surprise-envelope py-6 rounded-2xl bg-zinc-950 border border-white/15 hover:border-amber-400 transition flex flex-col items-center justify-center gap-1.5 opacity-55 cursor-not-allowed">
                            <span class="text-2xl">✉️</span>
                            <span class="text-xs font-extrabold text-amber-300">Sobre 1</span>
                        </button>
                        <button type="button" data-envelope-index="2" class="surprise-envelope py-6 rounded-2xl bg-zinc-950 border border-white/15 hover:border-amber-400 transition flex flex-col items-center justify-center gap-1.5 opacity-55 cursor-not-allowed">
                            <span class="text-2xl">✉️</span>
                            <span class="text-xs font-extrabold text-amber-300">Sobre 2</span>
                        </button>
                        <button type="button" data-envelope-index="3" class="surprise-envelope py-6 rounded-2xl bg-zinc-950 border border-white/15 hover:border-amber-400 transition flex flex-col items-center justify-center gap-1.5 opacity-55 cursor-not-allowed">
                            <span class="text-2xl">✉️</span>
                            <span class="text-xs font-extrabold text-amber-300">Sobre 3</span>
                        </button>
                    </div>
                </div>

                <div id="wonPrizeBox" class="hidden rounded-2xl bg-amber-400/15 border border-amber-400/50 p-4 text-center space-y-3">
                    <div class="text-xs font-extrabold uppercase tracking-wider text-amber-300">¡Premio desbloqueado!</div>
                    <div id="wonPrizeSummary" class="text-base sm:text-lg font-black text-white"></div>
                    <button id="btnProceedClaimForm" type="button" class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-zinc-950 font-extrabold text-sm transition">
                        Continuar al formulario final →
                    </button>
                </div>
            </div>

            <!-- Paso 2: Formulario final de reclamación y envío a WhatsApp -->
            <form id="claimOrderForm" class="hidden space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Nombre *</label>
                        <input id="claimFirstNameField" type="text" required placeholder="Ej. Andrés" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-950 border border-white/10 text-sm focus:outline-none focus:border-amber-400">
                    </div>
                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">Apellido *</label>
                        <input id="claimLastNameField" type="text" required placeholder="Ej. Restrepo" class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-950 border border-white/10 text-sm focus:outline-none focus:border-amber-400">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs text-zinc-400 mb-1">WhatsApp *</label>
